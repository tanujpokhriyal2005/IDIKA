<?xml version="1.0" encoding="utf-8"?>
<!-- Local testing talks to the laptop over plain HTTP (adb reverse / LAN).
     Step 2 deployment switches the API URL to HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
